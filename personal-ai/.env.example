# 默认请在应用的“模型设置”中保存和选择模型。
# 如需由部署者强制锁定模型，可取消下列注释；完整配置会覆盖所有前端选择。
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=model-name
# LLM_TIMEOUT_SECONDS=60
# LLM_CONTEXT_WINDOW_TOKENS=12096
# LLM_MAX_OUTPUT_TOKENS=4096

# 数据目录默认位于当前系统用户目录。下面的目录覆盖仅用于开发，通常不必取消注释。

# ===== Agent Runtime =====
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=180

# ===== Tools / Approval =====
TOOLS_ENABLED=true
TOOL_TIMEOUT_SECONDS=30
APPROVAL_TIMEOUT_SECONDS=60
# SANDBOX_DIR=./data/sandbox
SKILLS_DIR=./skills
# SKILL_TRASH_DIR=./data/skill-trash
PLUGINS_DIR=./plugins
# PLUGIN_TRASH_DIR=./data/plugin-trash
# ARTIFACTS_DIR=./data/artifacts
ARTIFACT_MAX_BYTES=52428800
# 文件下载统一走同源 /api 地址，不需要单独的对外地址。
# CODING_WORKSPACE_DIR=./data/coding-workspace
# WORKSPACE_ROOT_DIR=./data/coding-workspace
CODING_CHECK_TIMEOUT_SECONDS=120
# RUNTIME_SETTINGS_FILE=./data/runtime-settings.json

# ===== MCP =====
MCP_ENABLED=true
MCP_CONFIG_FILE=./config/mcp_servers.yaml

# ===== Activity Worker =====
ACTIVITY_ENABLED=true
ACTIVITY_POLL_SECONDS=5

# ===== Planner =====
PLANNER_ENABLED=true
PLANNER_MAX_STEPS=6
PLANNER_MAX_REPLANS=1
PLANNER_STEP_MAX_TURNS=3
PLANNER_MAX_TOOL_CALLS=12
PLANNER_OBSERVATION_TOKENS_BUDGET=1200

# ===== Context Engine =====
CONTEXT_MAX_TOKENS=8000
CONTEXT_RECENT_MESSAGES=40
MEMORY_TOKENS_BUDGET=600
RAG_TOKENS_BUDGET=800
SUMMARY_TOKENS_BUDGET=800

# ===== Memory / Summary =====
MEMORY_ENABLED=true
MEMORY_RECALL_LIMIT=5
MEMORY_MIN_IMPORTANCE=3
MEMORY_MIN_CONFIDENCE=0.7
SUMMARY_TRIGGER_MESSAGES=12
SUMMARY_KEEP_RECENT_MESSAGES=6

# ===== RAG / Chunking =====
RAG_ENABLED=true
RAG_QUERY_GATE_ENABLED=true
RAG_VECTOR_TOP_K=12
RAG_BM25_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_RRF_K=60
RAG_MIN_VECTOR_SIMILARITY=0.30
RAG_CHUNK_TARGET_CHARS=450
RAG_CHUNK_MAX_CHARS=700
RAG_CHUNK_MAX_TOKENS=420
RAG_CHUNK_OVERLAP_SENTENCES=1

# ===== Files =====
# FILE_STORAGE_DIR=./data/uploads
FILE_MAX_BYTES=10485760
FILE_ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md
FILE_MAX_PAGES=300
FILE_MAX_PARSED_CHARS=2000000
FILE_MAX_CHUNKS=5000
DOCX_MAX_UNCOMPRESSED_BYTES=52428800
INDEX_TIMEOUT_SECONDS=180
PDF_NEEDS_OCR_MIN_CHARS=100
PDF_NEEDS_OCR_MIN_TEXT_PAGE_RATIO=0.2

# ===== Chat Images =====
# CHAT_IMAGE_STORAGE_DIR=./data/chat-images
CHAT_IMAGE_MAX_BYTES=10485760
CHAT_IMAGE_MAX_COUNT=4
CHAT_IMAGE_MAX_PIXELS=16777216
CHAT_IMAGE_RECENT_TURNS=2

# ===== Agent Avatars =====
AGENT_AVATAR_STORAGE_DIR=./data/agent-avatars

# ===== Embedding =====
# 默认未下载时使用关键词检索；在设置页一键下载后启用本地语义检索。
# provider: fastembed | keyword | openai-compatible | local（旧模型兼容）| mock（测试）
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
# 以下由设置页管理，通常无需修改源码或配置文件。
EMBEDDING_MODEL_PATH=
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# 仅服务支持 dimensions 参数时启用。
EMBEDDING_REQUEST_DIMENSIONS=false
CHARACTER_MEMORY_TOKENS_BUDGET=1800

# ===== Database =====
# SQLite 为每台电脑保存本地文件，不需要数据库服务或密码。
# 默认自动使用当前系统用户目录；开发时可取消下一行注释。
# DATABASE_URL=sqlite:///./data/personal-ai.db

# ===== API =====
CORS_ORIGINS=http://localhost:4321,http://127.0.0.1:4321,http://localhost:4322,http://127.0.0.1:4322

# ===== 本机账号 =====
# 首次设置在本机浏览器直接完成；设置码只在从其他设备访问时才需要。
# AUTH_SETUP_TOKEN_FILE=./data/auth-setup-token
AUTH_SESSION_HOURS=168
AUTH_SESSION_REMEMBER_HOURS=720
# 仅当页面通过 HTTPS 提供服务时设为 true。
AUTH_COOKIE_SECURE=false
